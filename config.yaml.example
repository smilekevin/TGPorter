api_hash: your_api_hash
api_id: your_api_id
bot_token: your_bot_token
#chat:
#- chat_id: telegram_chat_id
#  last_read_message_id: 0
#  download_filter: message_date >= 2022-12-01 00:00:00 and message_date <= 2023-01-17 00:00:00
#- chat_id: telegram_chat_id_2
#  last_read_message_id: 0
# 我们将ids_to_retry移到data.yaml
ids_to_retry: []
media_types:
- audio
- document
- photo
- video
- voice
- animation #gif
file_formats:
  audio:
  - all
  document:
  - pdf
  - epub
  video:
  - mp4
save_path: /app/downloads
file_path_prefix:
#- chat_title
#- media_datetime
#upload_drive:
#  enable_upload_file: false
#  remote_dir: drive:/telegram
#  before_upload_file_zip: True
#  after_upload_file_delete: True
hide_file_name: false
file_name_prefix:
- file_name
#file_name_prefix_split: ' - '
max_download_task: 5
# 单文件启动时固定分片数上限；设为 1 使用单路下载。
file_download_concurrency: 4
# 实际分片数 = min(单文件并发数, max(1, 文件大小 // 最小分片大小))。
# 最小分片大小（单位 MiB）；不足此大小时使用串行下载。
download_min_part_size_mb: 16
web_host: 0.0.0.0
web_port: 5000
# WebUI 访问密码；部署前修改。设为 "" 可关闭密码登录。
web_login_secret: "replace-with-a-long-password"
allowed_user_ids:
- 'me'
date_format: ''
enable_download_txt: false
language: ZH
proxy:
  scheme: http
  hostname: 172.17.0.1
  port: 20172
log_level: DEBUG
