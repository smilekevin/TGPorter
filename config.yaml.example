# OPTIONAL: initial YAML configuration; web Configuration is preferred.
# Copy to config.yaml and edit before the first start; imported only when data/settings.json is absent.
# Login uses Configuration by default. Add --login explicitly for terminal authorization.
# Example values are not all application defaults; edit credentials, paths and proxy for your environment.
api_hash: your_api_hash
api_id: your_api_id
# Bot for commands and notifications; set to "" when submitting tasks only through MCP.
bot_token: your_bot_token
#chat:
# Initial scan bounds; saved data/data.json checkpoints take precedence when further ahead.
#- chat_id: telegram_chat_id
#  last_read_message_id: 0
#  download_filter: message_date >= 2022-12-01 00:00:00 and message_date <= 2023-01-17 00:00:00
#- chat_id: telegram_chat_id_2
#  last_read_message_id: 0
# Runtime retry IDs are saved automatically in data/data.json.
media_types:
- audio
- document
- photo
- video
- voice
- animation #gif
file_formats:
  audio:
  - all
  document:
  - pdf
  - epub
  video:
  - mp4
save_path: /app/downloads
# Staging defaults to save_path/.temp; no separate temporary directory mount is needed.
file_path_prefix:
#- chat_title
#- media_datetime
#upload_drive:
#  enable_upload_file: false
#  remote_dir: drive:/telegram
#  before_upload_file_zip: True
#  after_upload_file_delete: True
hide_file_name: false
file_name_prefix:
- file_name
#file_name_prefix_split: ' - '
# Initial file limit; saved data/data.json overrides it. WebUI/API/MCP changes save immediately.
max_download_task: 5
# Workers per file; each uses an independent connection and takes another part when finished.
file_download_concurrency: 4
# Fixed part size in MiB; the last part contains the remainder, and small files use one part.
download_part_size_mb: 64
web_host: 0.0.0.0
web_port: 5000
# WebUI password; change before deployment. Set to "" to disable password login.
web_login_secret: "Replace-with-your-password1"
# Optional random token for /mcp only, independent of the WebUI password; Web APIs use sessions only.
mcp_token: ""
# Optional /mcp endpoint on the same web_port as WebUI / Web APIs; requires mcp_token when enabled.
mcp_enabled: false
# Expose only MCP query tools; independent browser sessions are unaffected.
mcp_read_only: false
# Optional additional allowed hosts (domain or IP, with optional port), e.g. ["nas.example.com", "192.168.1.20:5000"].
# Localhost / loopback are allowed by default; do not use full /mcp URLs or wildcards.
mcp_allowed_hosts: []
allowed_user_ids:
- 'me'
date_format: ''
enable_download_txt: false
# Initial Bot/log language; a saved data/data.json language takes precedence.
# WebUI uses its own browser preference. Ad settings here are startup defaults only.
# en / zh-cn / zh-tw / ja / es / fr / ru / uk (legacy ZH and UA still work).
language: zh-cn
proxy:
  scheme: http
  hostname: 172.17.0.1
  port: 20172
log_level: DEBUG
